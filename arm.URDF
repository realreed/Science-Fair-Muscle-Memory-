
<?xml version="1.0"?>
<robot name="two_joint_arm">

  <!-- Fixed base -->
  <link name="base">
    <visual>
      <geometry>
        <cylinder radius="0.08" length="0.10"/>
      </geometry>
      <material name="gray">
        <color rgba="0.3 0.3 0.3 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.08" length="0.10"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="2.0"/>
      <inertia ixx="0.0045" ixy="0" ixz="0"
               iyy="0.0045" iyz="0" izz="0.0064"/>
    </inertial>
  </link>

  <!-- First arm link: 0.5 meters -->
  <link name="link1">
    <visual>
      <origin xyz="0.25 0 0"/>
      <geometry>
        <box size="0.5 0.05 0.05"/>
      </geometry>
      <material name="blue">
        <color rgba="0.1 0.4 0.9 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0.25 0 0"/>
      <geometry>
        <box size="0.5 0.05 0.05"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.25 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.000417" ixy="0" ixz="0"
               iyy="0.02104" iyz="0" izz="0.02104"/>
    </inertial>
  </link>

  <!-- Shoulder joint -->
  <joint name="shoulder" type="revolute">
    <parent link="base"/>
    <child link="link1"/>
    <origin xyz="0 0 0.05"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14"
           effort="100" velocity="2"/>
  </joint>

  <!-- Second arm link: 0.5 meters -->
  <link name="link2">
    <visual>
      <origin xyz="0.25 0 0"/>
      <geometry>
        <box size="0.5 0.04 0.04"/>
      </geometry>
      <material name="cyan">
        <color rgba="0.1 0.8 0.85 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0.25 0 0"/>
      <geometry>
        <box size="0.5 0.04 0.04"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.25 0 0"/>
      <mass value="0.7"/>
      <inertia ixx="0.000187" ixy="0" ixz="0"
               iyy="0.01468" iyz="0" izz="0.01468"/>
    </inertial>
  </link>

  <!-- Elbow joint -->
  <joint name="elbow" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0.5 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.8" upper="2.8"
           effort="80" velocity="2"/>
  </joint>

  <!-- End-effector marker -->
  <link name="end_effector">
    <visual>
      <geometry>
        <sphere radius="0.025"/>
      </geometry>
      <material name="red">
        <color rgba="1 0.1 0.1 1"/>
      </material>
    </visual>
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.0000025" ixy="0" ixz="0"
               iyy="0.0000025" iyz="0" izz="0.0000025"/>
    </inertial>
  </link>

  <!-- Fixed attachment at tip of second link -->
  <joint name="end_effector_mount" type="fixed">
    <parent link="link2"/>
    <child link="end_effector"/>
    <origin xyz="0.5 0 0"/>
  </joint>

</robot>
